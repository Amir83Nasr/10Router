# 10Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
# DATA_DIR is a Unix path (/var/lib/10router). Not writable on macOS/Windows —
# leaving it commented falls back to the default (~/.10router).
# DATA_DIR=/var/lib/10router

# Runtime
PORT=20128
NODE_ENV=production

# Local dev servers (`pnpm dev` / `pnpm dev:ui`) — read by scripts/dev-local.mjs.
# Precedence: CLI args > real env > .env.local > .env > default.
# Main dev server defaults: port 20127, DATA_DIR unset (= ~/.10router).
# DEV_PORT=20127
# DEV_DATA_DIR=
# Isolated UI test server defaults: port 20129, DATA_DIR ~/.10router-dev
# (separate DB so UI testing never touches the real one).
# DEV_UI_PORT=20129
# DEV_UI_DATA_DIR=~/.10router-dev

# Security
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
AUTH_COOKIE_SECURE=false
# Trust X-Forwarded-For only behind a loopback reverse proxy. Default false.
# TRUST_PROXY=false
# /api/shutdown only exists in non-production and needs `Bearer <secret>`.
# SHUTDOWN_SECRET=

# Feature flags
# ENABLE_TRANSLATOR=false
# Truthy 1/true/yes/on disables proactive OAuth token refresh.
# DISABLE_BACKGROUND_TOKEN_REFRESH=1

# Observability / logs
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# LOG_LEVEL=DEBUG/INFO/WARN/ERROR. Default INFO.
# LOG_LEVEL=INFO
# OBSERVABILITY_MAX_RECORDS=200
# OBSERVABILITY_BATCH_SIZE=20
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=5 (KB)

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://10router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://10router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional GitHub token for the update checker (/api/version → api.github.com
# tags). Without it the check uses the 60 req/h anonymous quota; when the
# API is unreachable or rate-limited the banner stays hidden (fail-open).
# GITHUB_TOKEN=ghp_...
# Default in code: http://localhost:8888/search
# SEARXNG_URL=http://searxng:8080/search
