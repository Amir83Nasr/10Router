{
  "name": "@amir83nasr/10router",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir83Nasr/10Router.git"
  },
  "packageManager": "pnpm@12.6.0",
  "description": "10Router dashboard",
  "bin": {
    "10router": "bin/10router.mjs"
  },
  "files": [
    "bin/",
    "custom-server.js",
    "src/",
    "open-sse/",
    "public/",
    "next.config.mjs",
    "LICENSE.md",
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/server/",
    ".next/static/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:update": "node scripts/test-update-notice.mjs",
    "build": "next build --webpack",
    "start": "node custom-server.js --port 20128",
    "pkg:test": "node scripts/test-pkg.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,scss,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "confbox": "^0.2.4",
    "jose": "^6.1.3",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.1",
    "next": "^16.1.6",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "sql.js": "^1.14.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
